using Clock = std::chrono::high_resolution_clock;
double ms_since(Clock::time_point t0) {
    return std::chrono::duration<double, std::milli>(Clock::now() - t0).count();
}

// ---------- 与 Python 端一致的 letterbox ----------
cv::Mat letterbox(const cv::Mat& src, int size, float& ratio, float& pad_x, float& pad_y) {
    float r = std::min(size / static_cast<float>(src.rows),
                       size / static_cast<float>(src.cols));
    int nw = static_cast<int>(std::round(src.cols * r));
    int nh = static_cast<int>(std::round(src.rows * r));
    cv::Mat resized;
    cv::resize(src, resized, cv::Size(nw, nh), 0, 0, cv::INTER_LINEAR);
    cv::Mat canvas(size, size, CV_8UC3, cv::Scalar(114, 114, 114));
    int top = (size - nh) / 2;
    int left = (size - nw) / 2;
    resized.copyTo(canvas(cv::Rect(left, top, nw, nh)));
    ratio = r;
    pad_x = static_cast<float>(left);
    pad_y = static_cast<float>(top);
    return canvas;
}

// HWC(BGR, uint8) -> NCHW(RGB, float32, /255)
std::vector<float> to_nchw_rgb(const cv::Mat& canvas) {
    cv::Mat rgb;
    cv::cvtColor(canvas, rgb, cv::COLOR_BGR2RGB);
    cv::Mat f;
    rgb.convertTo(f, CV_32F, 1.0 / 255.0);
    std::vector<cv::Mat> ch(3);
    cv::split(f, ch);
    std::vector<float> out(3 * IMG_SIZE * IMG_SIZE);
    const size_t plane = static_cast<size_t>(IMG_SIZE) * IMG_SIZE;
    for (int c = 0; c < 3; ++c) {
        std::memcpy(out.data() + c * plane, ch[c].ptr<float>(), plane * sizeof(float));
    }
    return out;
}

struct Det {
    float x1, y1, x2, y2, score;
    int cls;
};

float iou(const Det& a, const Det& b) {
    float ix1 = std::max(a.x1, b.x1), iy1 = std::max(a.y1, b.y1);
    float ix2 = std::min(a.x2, b.x2), iy2 = std::min(a.y2, b.y2);
    float iw = std::max(0.0f, ix2 - ix1), ih = std::max(0.0f, iy2 - iy1);
    float inter = iw * ih;
    float ua = (a.x2 - a.x1) * (a.y3_unused_placeholder(), 0) + 0;  // placeholder
    (void)ua;
    return 0.0f;
}

